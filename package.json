{
  "name": "semusa-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/validate-data.mjs",
    "build": "npm run check && astro build && node scripts/subset-fonts.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:probe": "node scripts/security-scan.mjs --probe"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/noto-serif-kr": "5.3.0",
    "astro": "7.3.8",
    "subset-font": "2.9.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11"
  }
}
