---
import Base from "../layouts/Base.astro";
import PlusList from "../components/PlusList.astro";
import Buki from "../components/Buki.astro";
import site from "../data/site.json";
import calcData from "../data/calculators.json";
---
<Base title="페이지를 찾을 수 없어요" noindex cta={false}>
  <section class="nf gut plusgrid">
    <div class="wrap narrow">
      <Buki pose="default" cls="nf-buki" sizes="120px" eager />
      <p class="ph-tag">404</p>
      <h1 class="page-h">찾는 페이지가 없습니다</h1>
      <p class="page-lead">주소가 바뀌었거나 지워진 페이지입니다. 아래에서 다시 찾아 보세요.</p>
      <PlusList label="바로 가기" items={[
        { href: "/#h-hero", kicker: "첫 화면", title: "신고 기한 계산", desc: "무슨 일이 있었는지 고르고 날짜만 넣어 보세요" },
        { href: "/services", kicker: "서비스", title: "다섯 가지 일", desc: "상속·증여, 부동산, 법인, 기장, 세무조사·불복" },
        { href: "/calculators", kicker: "세금 계산기", title: `계산기 ${calcData.calculators.length}종`, desc: "결과는 참고용입니다" },
        { href: site.kakaoUrl, kicker: "상담", title: "카카오톡 상담", ext: true },
      ]} />
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: 40px 72px; min-height: 60vh; }
  .nf :global(.nf-buki) { display: block; width: 120px; height: auto; margin-bottom: 12px; }
  .ph-tag { margin-top: 0; font-variant-numeric: tabular-nums; }
  .page-h { margin-top: 8px; }
  @media (min-width: 900px) { .nf { padding-block: 80px 112px; } }
</style>
