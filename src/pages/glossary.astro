---
// 용어 풀이(2026-10-24 3차 C3): src/data/glossary.json — 쉬운 말 풀이 + 법조문 원문(글자 그대로, docs/glossary-sources.json과 대조) + 근거 조문.
// 풀이는 원문에 있는 것만(tests/glossary.test.mjs가 숫자를 대조). 원문 기준일은 각 조문의 시행일.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import glossary from "../data/glossary.json";
import sources from "../../docs/glossary-sources.json";
const GROUPS = ["신고·납부", "상속·증여", "부동산", "불복"];
const src: Record<string, any> = (sources as any).items;
const ymd = (s: string | null) => (s ? `${Number(s.slice(0, 4))}. ${Number(s.slice(4, 6))}. ${Number(s.slice(6, 8))}.` : "");
const terms = glossary.terms as any[];
// 줄 일부만 옮긴 인용은 앞뒤에 … (원문 줄은 docs/glossary-sources.json)
const shown = (q: any) => { const line = src[q.src].lines.find((l: string) => l.includes(q.text)) || q.text; return `${line.startsWith(q.text) ? "" : "… "}${q.text}${line.endsWith(q.text) ? "" : " …"}`; };
const dfn = { "@context": "https://schema.org", "@type": "DefinedTermSet", name: "세금 용어 풀이", hasDefinedTerm: terms.map((t) => ({ "@type": "DefinedTerm", name: t.term, description: t.plain })) };
---
<Base title="용어 풀이" description="양도·1세대·증여재산공제·경정청구·이의신청 등 세금 용어를 쉬운 말과 법조문 원문으로 풉니다." jsonLd={[dfn]}>
  <PageHead tag="용어 풀이" title="세금 말, 쉬운 말로" crumbs={[{ name: "용어 풀이" }]}
    lead="쉬운 말 풀이 아래에 법조문 원문을 그대로 붙였습니다. 풀이는 그 원문에 있는 것만 옮겼습니다." />
  <section class="gut gl-sec">
    <div class="wrap gl-in">
      <nav class="gl-idx" aria-label="용어 목록">
        {GROUPS.map((g) => (
          <div><p class="gl-ih">{g}</p><ul>{terms.filter((t) => t.group === g).map((t) => <li><a href={`#g-${t.id}`}>{t.term}</a></li>)}</ul></div>
        ))}
      </nav>
      {GROUPS.map((g) => (
        <section class="gl-grp" aria-labelledby={`gh-${g}`}>
          <h2 class="sec-h gl-gh" id={`gh-${g}`}>{g}</h2>
          {terms.filter((t) => t.group === g).map((t) => (
            <article class="gl-t" id={`g-${t.id}`}>
              <h3 class="gl-term">{t.term}</h3>
              <p class="gl-plain">{t.plain}</p>
              <details class="gl-src">
                <summary>법조문 원문 · {t.law}</summary>
                {t.quotes.map((q: any) => <blockquote>{shown(q)}</blockquote>)}
                <p class="gl-meta">{[...new Set(t.quotes.map((q: any) => q.src))].map((id: any) => `${src[id].law} ${src[id].article}(${src[id].title}) — 시행 ${ymd(src[id].effectiveDate)}`).join(" · ")} · 출처 법제처 국가법령정보</p>
              </details>
              {t.links.length > 0 && <p class="gl-links">{t.links.map((l: any) => <a class="go" href={l.u}>{l.t} ›</a>)}</p>}
            </article>
          ))}
        </section>
      ))}
      <p class="gl-note">원문은 각 조문의 시행일 기준입니다. 법이 바뀌면 달라질 수 있으니, 실제 일은 상담 때 함께 확인합니다.</p>
    </div>
  </section>
</Base>

<style>
  .gl-sec { padding-block: 24px 64px; }
  .gl-in { display: grid; gap: 36px; }
  .gl-idx { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px 28px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; }
  .gl-ih { font-size: 14px; font-weight: 700; color: var(--gold-text); margin-bottom: 4px; }
  .gl-idx ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 14px; }
  .gl-idx a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-size: 16px; text-underline-offset: 4px; }
  .gl-grp { display: grid; gap: 14px; }
  .gl-gh { margin-bottom: 4px; }
  .gl-t { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; display: grid; gap: 10px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .gl-t:target { border-color: var(--gold); box-shadow: 0 0 0 2px var(--gold-soft); }
  .gl-term { font-size: 20px; font-weight: 700; padding-left: 10px; border-left: 3px solid var(--gold); line-height: 1.3; }
  .gl-plain { font-size: 17px; line-height: 1.75; }
  .gl-src summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: 15px; font-weight: 600; color: var(--moss); }
  .gl-src summary:focus-visible { outline: 3px solid var(--moss); outline-offset: 2px; }
  .gl-src blockquote { margin: 6px 0 0; padding: 10px 14px; border-left: 2px solid var(--line2); background: var(--paper); font-size: 15px; line-height: 1.75; color: var(--ink2); }
  .gl-meta { margin-top: 8px; font-size: 14px; color: var(--ink2); }
  .gl-links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .gl-links .go { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0; padding-top: 0; }
  .gl-note { font-size: 14.5px; color: var(--ink2); }
</style>
