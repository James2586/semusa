---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import VideoCard from "../components/VideoCard.astro";
import Thumb from "../components/Thumb.astro";
import { topicOf } from "../lib/thumbTopic.js";
import { inkFor, bookAuthors } from "../lib/shelf.js";
import site from "../data/site.json";
import home from "../data/home.json";
import videoData from "../data/videos.json";
import press from "../data/press.json";
import PlusList from "../components/PlusList.astro";
import { fetchBlogPosts } from "../lib/blogFeed.js";

// 네이버 블로그 최신 글: 빌드할 때 한 번 읽는다. 못 읽으면 블로그 카드만 빠지고 페이지는 그대로 만든다.
const posts = await fetchBlogPosts("https://rss.blog.naver.com/semusatax.xml", 7);
const [featured, ...restPosts] = posts;
const ch = Object.fromEntries(site.channels.map((c) => [c.name, c.url]));

// 그린 표지(사진 없는 책): 제목 앞 머리말("알면 돈 버는" 등)은 작은 글자로 따로
const KICKER = /^(알면 돈 버는|알면 돈이 되는|알아두면 돈이 되는|크리에이터를 위한) /;
const kickerOf = (t: string) => t.match(KICKER)?.[1] || "";
type Card = { kind: string; title: string; text?: string; date?: string; href: string; external: boolean; go: string; thumb: "art" | "book" | "video"; topic?: { id: string; label: string }; image?: string; color?: string; poster?: string; cover?: string };
const cards: Card[] = [
  ...restPosts.map((p) => ({ kind: "블로그", title: p.title, text: p.excerpt, date: p.date, href: p.link, external: true, go: "블로그에서 읽기", thumb: "art" as const, topic: topicOf(p.title), image: p.image })),
  { kind: "칼럼", title: "이코노미조선 칼럼 모아 보기", text: "이코노미조선에 연재한 세금 칼럼을 한곳에서 읽어 보세요.", href: ch["이코노미조선 칼럼"], external: true, go: "칼럼 읽기", thumb: "art", topic: { id: "column", label: "이코노미조선 칼럼" } },
  ...home.books.map((b) => ({ kind: "책", title: b.title, text: `${bookAuthors(site.rep, b)} 지음`, href: site.booksUrl, external: true, go: "교보문고에서 보기", thumb: "book" as const, color: b.color, cover: (b as any).cover })),
  { kind: "책", title: `책 ${home.booksTotal}권 전체 보기`, text: "상속·증여, 법인, 부동산, 업종별 세무관리까지 직접 쓴 책 목록입니다.", href: site.booksUrl, external: true, go: "교보문고에서 보기", thumb: "art", topic: { id: "books", label: `책 ${home.booksTotal}권` } },
  ...videoData.videos.map((v) => ({ kind: "영상", title: v.title, text: v.note, href: `/about#video-${v.id}`, external: false, go: "영상 보기", thumb: "video" as const, poster: v.poster })),
];
const channels = site.channels.filter((c) => c.name !== "이코노미조선 칼럼");
// 검색 노출(5차 B1): 저서(Book — 제목·출간 연월은 home.json 그대로)와 지면 칼럼(Article — 지면 제목·날짜 그대로)
const author = { "@type": "Person", name: site.rep, jobTitle: site.repTitle };
const booksLd = home.books.map((b: any) => ({ "@context": "https://schema.org", "@type": "Book", name: b.title, author: b.coauthors ? [author, ...b.coauthors.map((n: string) => ({ "@type": "Person", name: n }))] : author, ...(b.date ? { datePublished: b.date } : {}), url: site.booksUrl }));
const articlesLd = (press.articles || []).map((a: any) => ({ "@context": "https://schema.org", "@type": "Article", headline: a.title, datePublished: a.date, url: a.url, author, publisher: { "@type": "Organization", name: "이코노미조선" } }));
const kinds = ["전체", ...new Set(cards.map((c) => c.kind))];
// 지면에 실린 칼럼(src/data/press.json) — 지면 그림 + 제목 그대로, 이코노미조선 기사로. 연재 목록은 articles(제목·날짜 그대로)
const pressDate = (iso: string) => iso.split("-").map(Number).join(". ") + ".";
---
<Base title="칼럼·책" description={`${site.repTitle} ${site.rep}의 책 ${home.booksTotal}권과 이코노미조선 칼럼, 블로그, 영상.`} jsonLd={[...booksLd, ...articlesLd]}>
  <PageHead tag="칼럼·책" photo={{ name: "own-face", w: [600, 900], ratio: "6 / 5" }} title="칼럼·책" crumbs={[{ name: "칼럼·책" }]} lead={`상속·증여, 법인, 부동산 세금을 다룬 책 ${home.booksTotal}권을 직접 썼고, 이코노미조선에 칼럼을 연재합니다.`} />

  <section class="gut feat-sec" aria-label="대표 글">
    <div class="wrap">
      {featured ? (
        <a class="feat" href={featured.link} target="_blank" rel="noopener">
          <span class="chip chip-on-dark">블로그 · 최신 글</span>
          <span class="feat-t">{featured.title}</span>
          {featured.date && <time datetime={featured.date}>{featured.date.replaceAll("-", ".")}</time>}
          {featured.excerpt && <span class="feat-x">{featured.excerpt}</span>}
          <span class="feat-go">읽기 ↗</span>
        </a>
      ) : (
        <div class="feat feat-video">
          <div>
            <span class="chip chip-on-dark">영상 · 1분 소개</span>
            <p class="feat-t">책을 쓰고, 도구를 만들고, 근거로 말합니다.</p>
            <p class="feat-x">{site.repTitle} {site.rep}이 일하는 방식을 1분 영상으로 소개합니다.</p>
          </div>
          <VideoCard id="portfolio" dark />
        </div>
      )}
    </div>
  </section>

  {press.items.length > 0 && (
    <section class="gut press-sec" aria-labelledby="h-press">
      <div class="wrap">
        <span class="tag">지면에 실린 칼럼</span>
        <h2 class="sec-h" id="h-press">{press.items[0].outlet} 「{press.items[0].series}」</h2>
        <div class="press-list">
          {press.items.map((p) => (
            <article class="press">
              <a class="press-img" href={`/img/press/${p.image}-1600.webp`} target="_blank" rel="noopener">
                <img src={`/img/press/${p.image}-1600.webp`} srcset={`/img/press/${p.image}-800.webp 800w, /img/press/${p.image}-1600.webp 1600w`} sizes="(min-width: 1080px) 640px, 100vw" width={p.size[0]} height={p.size[1]} alt={`${p.outlet} ${pressDate(p.date)} ${p.pages} 「${p.series} <${p.no}>」 지면`} loading="lazy" decoding="async" />
                <span class="press-zoom">지면 크게 보기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></span>
              </a>
              <div class="press-meta">
                <small>{p.outlet} · {pressDate(p.date)} · {p.pages} · 「{p.series} &lt;{p.no}&gt;」</small>
                <a class="press-t" href={p.url} target="_blank" rel="noopener">{p.title}<span class="sr-only">(이코노미조선, 새 창)</span></a>
                <a class="go" href={p.url} target="_blank" rel="noopener">이코노미조선에서 읽기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a>
              </div>
            </article>
          ))}
        </div>
        {press.articles?.length > 0 && (
          <>
            <h3 class="press-h">연재한 칼럼 {press.articles.length}편</h3>
            <div class="press-chips" role="group" aria-label="칼럼 주제로 거르기">
              {["전체", ...new Set(press.articles.map((a: any) => a.topic))].map((t, i) => <button type="button" class="fchip" aria-pressed={i === 0 ? "true" : "false"} data-topic={t}>{t}</button>)}
            </div>
            <p class="sr-only" role="status" id="press-status"></p>
            <div id="press-list"><PlusList label="이코노미조선 칼럼" items={press.articles.map((a: any) => ({ href: a.url, ext: true, kicker: `${pressDate(a.date)} · ${a.topic}`, title: a.title, attrs: { "data-topic": a.topic } }))} /></div>
            <p class="more"><a class="more-link" href={ch["이코노미조선 칼럼"]} target="_blank" rel="noopener">이코노미조선에서 전체 보기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a></p>
          </>
        )}
      </div>
    </section>
  )}

  <section class="gut list-sec" aria-labelledby="h-all" style="padding-bottom:64px">
    <div class="wrap">
      <div class="list-hd">
        <h2 class="sec-h" id="h-all">모두 보기</h2>
        <div class="filters" role="group" aria-label="종류로 거르기">
          {kinds.map((k, i) => <button type="button" class="flt fchip" aria-pressed={i === 0 ? "true" : "false"} data-kind={k}>{k}</button>)}
        </div>
      </div>
      <p class="sr-only" role="status" id="flt-status"></p>
      <ul class="cards reveal">
        {cards.map((c) => (
          <li data-kind={c.kind} data-drawn={c.thumb === "book" && !c.cover ? "" : undefined}>
            <a class="card-a" href={c.href} {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
              <span class:list={["thumb", `thumb-${c.thumb}`]} aria-hidden="true">
                {c.thumb === "art" && <Thumb topic={c.topic!.id} label={c.topic!.label} image={c.image} books={home.books.slice(0, 2).map((b) => b.color)} />}
                {c.thumb === "book" && (c.cover ? <img class="tbi" src={c.cover} alt="" width="400" height="571" loading="lazy" decoding="async" /> : <span class="tb" style={`--c:${c.color};color:${inkFor(c.color || "#1E3A2A")}`}>{kickerOf(c.title) && <i class="tb-k">{kickerOf(c.title)}</i>}<b>{c.title.replace(KICKER, "")}</b><small>{site.rep}</small></span>)}
                {c.thumb === "video" && <img src={c.poster} alt="" loading="lazy" width="540" height="960" />}
              </span>
              <span class="chip">{c.kind}</span>
              <span class="ct">{c.title}</span>
              {c.date && <time datetime={c.date}>{c.date.replaceAll("-", ".")}</time>}
              {c.text && <span class="cx">{c.text}</span>}
              <span class="go">{c.go} {c.external ? <><span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></> : <span aria-hidden="true">›</span>}</span>
            </a>
          </li>
        ))}
      </ul>

      <section class="follow" aria-labelledby="h-follow">
        <div>
          <h2 class="sec-h follow-h" id="h-follow">새 글 받아 보기</h2>
          <p>네이버 블로그·세금 인플루언서·인스타그램·유튜브에 새 세금 글과 영상을 올립니다. 이웃 추가나 팔로우, 구독을 해 두시면 새 글이 올라올 때 바로 보실 수 있습니다.</p>
        </div>
        <ul>
          {channels.map((c) => <li><a href={(c as any).link || c.url} target="_blank" rel="noopener">{c.name} <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a></li>)}
        </ul>
      </section>
    </div>
  </section>

</Base>

<style>
  .feat-sec { padding-bottom: 40px; }
  .press-sec { padding-bottom: 48px; }
  .press-list { margin-top: 16px; display: grid; gap: 20px; }
  .press { display: grid; gap: 14px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
  .press-img { display: grid; gap: 6px; text-decoration: none; }
  .press-zoom { justify-self: end; font-size: 14px; font-weight: 600; color: var(--gold-text); }
  .press-img:hover .press-zoom { text-decoration: underline; text-underline-offset: 4px; }
  .press-t { color: var(--ink); text-decoration: none; }
  .press-t:hover { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 5px; }
  .press .go { justify-self: start; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .press-h { margin-top: 36px; font-size: 18px; }
  .press-chips { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .press-sec .more { margin-top: 20px; }
  .press img { width: 100%; height: auto; display: block; border-radius: 4px; box-shadow: 0 10px 24px -18px rgba(21, 25, 21, .5); }
  .press-meta { display: grid; gap: 6px; align-content: center; padding: 0 4px 4px; }
  .press-meta small { font-size: 14px; color: var(--muted); }
  .press-t { font-family: var(--f-display); font-size: 22px; line-height: 1.4; }
  .press .go:hover { text-decoration: underline; text-underline-offset: 4px; }
  .feat { display: grid; gap: 12px; align-content: start; background: var(--moss); color: var(--on-moss); border-radius: 6px; padding: 28px 22px; text-decoration: none; }
  a.feat:hover .feat-go { text-decoration: underline; text-underline-offset: 4px; }
  .feat-t { font-family: var(--f-display); font-weight: 700; font-size: 26px; line-height: 1.35; }
  .feat time, .feat-x { color: var(--on-moss2); font-size: 16px; }
  .feat-go { color: var(--gold-hi); font-weight: 700; }
  .feat-video { gap: 24px; }
  .feat-video > div:first-child { display: grid; gap: 12px; align-content: start; }
  .chip { align-self: flex-start; justify-self: start; display: inline-block; font-size: 14px; font-weight: 700; padding: 3px 10px; background: var(--paper2); color: var(--ink2); border-radius: 2px; }
  .chip-on-dark { background: rgba(243, 240, 231, .14); color: var(--on-moss); }

  .list-hd { display: grid; gap: 12px; margin-bottom: 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .cards li { display: flex; }
  .card-a { flex: 1; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); }
  .thumb { display: block; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; position: relative; background: var(--moss); }
  .thumb > * { transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
  .card-a:hover .thumb > *, .card-a:focus-visible .thumb > * { transform: scale(1.05); }
  .thumb-book { display: grid; place-items: center; background: var(--paper2); }
  .tb { width: 27%; aspect-ratio: 3 / 4.3; background: var(--c); color: #FFF7E6; border-radius: 1px 3px 3px 1px; box-shadow: 0 12px 20px -12px rgba(0, 0, 0, .6), inset 3px 0 0 rgba(0, 0, 0, .18); padding: 8%; display: flex; }
  .tb::after { content: ""; display: block; width: 100%; height: 2px; margin-top: 18%; background: rgba(255, 247, 230, .7); }
  .tb b, .tb small, .tb-k { display: none; }
  /* 표지 벽("책"을 고르면): 표지만 2~6단으로 크게 — 제목은 표지 아래 한 줄 */
  .cards.wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  .wall .thumb { aspect-ratio: 400 / 571; background: none; overflow: visible; }
  .wall .tbi { position: static; width: 100%; height: 100%; object-fit: cover; }
  /* 그린 표지(표지 사진이 아직 없는 책): 책등 띠·가는 선·시리즈 이름·지은이로 표지처럼 — 아래 제목 줄은 겹쳐서 숨김 */
  .wall .tb { position: relative; width: 100%; height: 100%; aspect-ratio: auto; flex-direction: column; justify-content: flex-start; gap: 8px; padding: 14% 11% 12% 17%;
    background: linear-gradient(90deg, rgba(0, 0, 0, .22) 0 7%, rgba(255, 255, 255, .08) 7% 8%, transparent 8%), var(--c); }
  .wall .tb::after { display: none; }
  .wall .tb-k { display: block; font-style: normal; font-size: 14px; opacity: .85; padding-bottom: 8px; border-bottom: 1px solid currentColor; }
  .wall .tb b { display: block; font-size: 16px; line-height: 1.4; }
  .wall .tb small { display: block; margin-top: auto; font-size: 14px; }
  .wall li[data-drawn] .ct { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .wall .chip, .wall .cx, .wall .go { display: none; }
  .wall .ct { font-size: 15.5px; border-left: 0; padding-left: 0; }
  .wall .thumb-art { aspect-ratio: 400 / 571; }
  .wall li:last-child:nth-child(odd) { grid-column: auto; }
  /* 표지 사진: 칸 높이의 86%로 가운데(높이 % 가 먹도록 절대 위치) */
  .tbi { position: absolute; top: 7%; left: 0; right: 0; margin: 0 auto; height: 86%; width: auto; max-width: none; border-radius: 2px 4px 4px 2px; box-shadow: 0 12px 20px -12px rgba(0, 0, 0, .6); }
  .thumb-video img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .ct { font-size: 19px; font-weight: 700; line-height: 1.45; border-left: 3px solid var(--gold); padding-left: 11px; }
  .card-a:hover .go, .card-a:focus-visible .go { text-decoration: underline; text-underline-offset: 4px; }
  .card-a time { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .cx { color: var(--muted); font-size: 15.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cards li[hidden] { display: none; }
  /* 새 글 받아 보기(KPMG 소식지 상자 참고) — 소식지가 없으니 "구독"이라 하지 않는다 */
  .follow { margin-top: 56px; display: grid; gap: 20px; background: var(--moss); color: var(--on-moss); border-radius: 6px; padding: 28px 22px; }
  .follow-h { color: var(--on-moss); font-size: 26px; }
  .follow p { margin-top: 8px; color: var(--on-moss2); }
  .follow ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .follow a { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 52px; padding: 0 20px; border: 1.5px solid rgba(243, 240, 231, .55); border-radius: 999px; color: var(--on-moss); font-weight: 700; text-decoration: none; transition: background .2s, color .2s; }
  .follow a:hover, .follow a:focus-visible { background: var(--on-moss); color: var(--moss); }


  @media (min-width: 900px) {
    .feat { padding: 48px 48px; }
    .feat-t { font-size: 40px; }
    .feat-video { grid-template-columns: 1fr 300px; align-items: center; gap: 48px; }
    .list-hd { grid-template-columns: auto 1fr; align-items: center; gap: 24px; }
    .filters { justify-content: flex-end; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
    /* 카드가 홀수면 마지막 카드는 두 칸을 쓰고 그림을 왼쪽에 둔다(혼자 반 칸에 남지 않게) */
    .cards li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .cards li:last-child:nth-child(odd) .card-a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 32px; align-content: start; }
    .cards li:last-child:nth-child(odd) .thumb { grid-row: 1 / span 5; }
    .cards li:last-child:nth-child(odd) .chip { justify-self: start; }
    .cards.wall { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px 24px; }
    .wall li:last-child:nth-child(odd) .card-a { display: flex; }
    .press { grid-template-columns: minmax(0, 640px) minmax(0, 1fr); gap: 32px; padding: 16px; }
    .press-t { font-size: 28px; }
    .follow { grid-template-columns: 1fr auto; align-items: center; gap: 48px; padding: 44px 48px; }
    .follow ul { min-width: 300px; }
  }
</style>

<script>
  // 블로그 대표 사진을 못 불러오면 사진만 지워 아래 표지 그림이 보이게 한다
  document.querySelectorAll<HTMLImageElement>(".th-ph").forEach((img) => {
    const drop = () => img.remove();
    if (img.complete && img.naturalWidth === 0) drop(); else img.addEventListener("error", drop);
  });
  const btns = document.querySelectorAll<HTMLButtonElement>(".flt");
  const items = document.querySelectorAll<HTMLLIElement>(".cards li");
  const status = document.getElementById("flt-status")!;
  btns.forEach((b) => b.addEventListener("click", () => {
    const k = b.dataset.kind!;
    btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let n = 0;
    items.forEach((li) => { const show = k === "전체" || li.dataset.kind === k; li.hidden = !show; if (show) n++; });
    document.querySelector(".cards")!.classList.toggle("wall", k === "책");
    status.textContent = `${k} ${n}개`;
  }));
  // 칼럼 주제 칩(2026-10-24 3차 C1)
  const pchips = [...document.querySelectorAll<HTMLButtonElement>(".press-chips .fchip")];
  const prows = [...document.querySelectorAll<HTMLLIElement>("#press-list li[data-topic]")];
  for (const c of pchips) c.addEventListener("click", () => {
    const t = c.dataset.topic!;
    for (const o of pchips) o.setAttribute("aria-pressed", String(o === c));
    let n = 0;
    for (const li of prows) { const show = t === "전체" || li.dataset.topic === t; li.hidden = !show; if (show) n++; }
    document.getElementById("press-status")!.textContent = `${t} 칼럼 ${n}편`;
  });
</script>
