---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import VideoCard from "../components/VideoCard.astro";
import site from "../data/site.json";
import home from "../data/home.json";
import videoData from "../data/videos.json";
import { fetchBlogPosts } from "../lib/blogFeed.js";

// 네이버 블로그 최신 글: 빌드할 때 한 번 읽는다. 못 읽으면 블로그 카드만 빠지고 페이지는 그대로 만든다.
const posts = await fetchBlogPosts("https://rss.blog.naver.com/semusatax.xml", 7);
const [featured, ...restPosts] = posts;
const ch = Object.fromEntries(site.channels.map((c) => [c.name, c.url]));

type Card = { kind: string; title: string; text?: string; date?: string; href: string; external: boolean; go: string; thumb: "word" | "book" | "video"; color?: string; poster?: string };
const cards: Card[] = [
  ...restPosts.map((p) => ({ kind: "블로그", title: p.title, text: p.excerpt, date: p.date, href: p.link, external: true, go: "블로그에서 읽기", thumb: "word" as const })),
  { kind: "칼럼", title: "이코노미조선 칼럼 모아 보기", text: "이코노미조선에 연재한 세금 칼럼을 한곳에서 읽어 보세요.", href: ch["이코노미조선 칼럼"], external: true, go: "칼럼 읽기", thumb: "word" },
  ...home.books.map((b) => ({ kind: "책", title: b.title, text: `${site.rep} 지음`, href: site.booksUrl, external: true, go: "교보문고에서 보기", thumb: "book" as const, color: b.color })),
  { kind: "책", title: `책 ${home.booksTotal}권 전체 보기`, text: "상속·증여, 법인, 부동산, 업종별 세무관리까지 직접 쓴 책 목록입니다.", href: site.booksUrl, external: true, go: "교보문고에서 보기", thumb: "word" },
  ...videoData.videos.map((v) => ({ kind: "영상", title: v.title, text: v.note, href: `/about#video-${v.id}`, external: false, go: "영상 보기", thumb: "video" as const, poster: v.poster })),
];
const channels = site.channels.filter((c) => c.name !== "이코노미조선 칼럼");
const kinds = ["전체", ...new Set(cards.map((c) => c.kind))];
---
<Base title="칼럼·책" description={`${site.repTitle} ${site.rep}의 책 ${home.booksTotal}권과 이코노미조선 칼럼, 블로그, 영상.`}>
  <PageHead title="칼럼·책" crumbs={[{ name: "칼럼·책" }]} lead={`상속·증여, 법인, 부동산 세금을 다룬 책 ${home.booksTotal}권을 직접 썼고, 이코노미조선에 칼럼을 연재합니다.`} />

  <section class="gut feat-sec" aria-label="대표 글">
    <div class="wrap">
      {featured ? (
        <a class="feat" href={featured.link} target="_blank" rel="noopener">
          <span class="chip chip-on-dark">블로그 · 최신 글</span>
          <span class="feat-t">{featured.title}</span>
          {featured.date && <time datetime={featured.date}>{featured.date.replaceAll("-", ".")}</time>}
          {featured.excerpt && <span class="feat-x">{featured.excerpt}</span>}
          <span class="feat-go">읽기 ↗</span>
        </a>
      ) : (
        <div class="feat feat-video">
          <div>
            <span class="chip chip-on-dark">영상 · 1분 소개</span>
            <p class="feat-t">책을 쓰고, 도구를 만들고, 근거로 말합니다.</p>
            <p class="feat-x">{site.repTitle} {site.rep}이 일하는 방식을 1분 영상으로 소개합니다.</p>
          </div>
          <VideoCard id="portfolio" dark />
        </div>
      )}
    </div>
  </section>

  <section class="gut list-sec" aria-labelledby="h-all" style="padding-bottom:64px">
    <div class="wrap">
      <div class="list-hd">
        <h2 class="sec-h" id="h-all">모두 보기</h2>
        <div class="filters" role="group" aria-label="종류로 거르기">
          {kinds.map((k, i) => <button type="button" class="flt" aria-pressed={i === 0 ? "true" : "false"} data-kind={k}>{k}</button>)}
        </div>
      </div>
      <p class="sr-only" role="status" id="flt-status"></p>
      <ul class="cards">
        {cards.map((c) => (
          <li data-kind={c.kind}>
            <a class="card-a" href={c.href} {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
              <span class:list={["thumb", `thumb-${c.thumb}`]} aria-hidden="true">
                {c.thumb === "word" && <span class="tw">{c.kind}</span>}
                {c.thumb === "book" && <span class="tb" style={`--c:${c.color}`}></span>}
                {c.thumb === "video" && <img src={c.poster} alt="" loading="lazy" width="540" height="960" />}
              </span>
              <span class="chip">{c.kind}</span>
              <span class="ct">{c.title}</span>
              {c.date && <time datetime={c.date}>{c.date.replaceAll("-", ".")}</time>}
              {c.text && <span class="cx">{c.text}</span>}
              <span class="go">{c.go} {c.external ? <><span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></> : <span aria-hidden="true">›</span>}</span>
            </a>
          </li>
        ))}
      </ul>

      <section class="follow" aria-labelledby="h-follow">
        <div>
          <h2 class="sec-h follow-h" id="h-follow">새 글 받아 보기</h2>
          <p>네이버 블로그·세금 인플루언서·인스타그램에 새 세금 글을 올립니다. 이웃 추가나 팔로우를 해 두시면 새 글이 올라올 때 바로 보실 수 있습니다.</p>
        </div>
        <ul>
          {channels.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.name} <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a></li>)}
        </ul>
      </section>
    </div>
  </section>

</Base>

<style>
  .feat-sec { padding-bottom: 40px; }
  .feat { display: grid; gap: 12px; align-content: start; background: var(--moss); color: var(--on-moss); border-radius: 6px; padding: 28px 22px; text-decoration: none; }
  a.feat:hover .feat-go { text-decoration: underline; text-underline-offset: 4px; }
  .feat-t { font-family: var(--f-display); font-weight: 700; font-size: 26px; line-height: 1.35; }
  .feat time, .feat-x { color: var(--on-moss2); font-size: 16px; }
  .feat-go { color: var(--gold-hi); font-weight: 700; }
  .feat-video { gap: 24px; }
  .feat-video > div:first-child { display: grid; gap: 12px; align-content: start; }
  .chip { align-self: flex-start; justify-self: start; display: inline-block; font-size: 14px; font-weight: 700; padding: 3px 10px; background: var(--paper2); color: var(--ink2); border-radius: 2px; }
  .chip-on-dark { background: rgba(243, 240, 231, .14); color: var(--on-moss); }

  .list-hd { display: grid; gap: 12px; margin-bottom: 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .flt { min-height: 44px; padding: 0 16px; border: 1px solid var(--line2); background: var(--surface); color: var(--ink2); border-radius: 999px; font: 600 15.5px var(--f-body); cursor: pointer; }
  .flt[aria-pressed="true"] { background: var(--moss); border-color: var(--moss); color: var(--on-moss); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .cards li { display: flex; }
  .card-a { flex: 1; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); }
  .thumb { display: block; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; position: relative; background: var(--moss); }
  .thumb > * { transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
  .card-a:hover .thumb > *, .card-a:focus-visible .thumb > * { transform: scale(1.05); }
  .thumb-word { display: grid; place-items: center; background: linear-gradient(135deg, var(--moss) 0%, var(--moss2) 100%); }
  .tw { font-family: var(--f-display); font-weight: 700; font-size: 40px; color: rgba(243, 240, 231, .9); }
  .thumb-word::after { content: ""; position: absolute; left: 24px; right: 24px; bottom: 22px; height: 2px; background: var(--gold); opacity: .8; }
  .thumb-book { display: grid; place-items: center; background: var(--paper2); }
  .tb { width: 27%; aspect-ratio: 3 / 4.3; background: var(--c); color: #FFF7E6; border-radius: 1px 3px 3px 1px; box-shadow: 0 12px 20px -12px rgba(0, 0, 0, .6), inset 3px 0 0 rgba(0, 0, 0, .18); padding: 8%; display: flex; }
  .tb::after { content: ""; display: block; width: 100%; height: 2px; margin-top: 18%; background: rgba(255, 247, 230, .7); }
  .thumb-video img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .ct { font-size: 19px; font-weight: 700; line-height: 1.45; border-left: 3px solid var(--gold); padding-left: 11px; }
  .card-a:hover .go, .card-a:focus-visible .go { text-decoration: underline; text-underline-offset: 4px; }
  .card-a time { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .cx { color: var(--muted); font-size: 15.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cards li[hidden] { display: none; }
  /* 새 글 받아 보기(KPMG 소식지 상자 참고) — 소식지가 없으니 "구독"이라 하지 않는다 */
  .follow { margin-top: 56px; display: grid; gap: 20px; background: var(--moss); color: var(--on-moss); border-radius: 6px; padding: 28px 22px; }
  .follow-h { color: var(--on-moss); font-size: 26px; }
  .follow p { margin-top: 8px; color: var(--on-moss2); }
  .follow ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .follow a { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 52px; padding: 0 20px; border: 1.5px solid rgba(243, 240, 231, .55); border-radius: 999px; color: var(--on-moss); font-weight: 700; text-decoration: none; transition: background .2s, color .2s; }
  .follow a:hover, .follow a:focus-visible { background: var(--on-moss); color: var(--moss); }


  @media (min-width: 900px) {
    .feat { padding: 48px 48px; }
    .feat-t { font-size: 40px; }
    .feat-video { grid-template-columns: 1fr 300px; align-items: center; gap: 48px; }
    .list-hd { grid-template-columns: auto 1fr; align-items: center; gap: 24px; }
    .filters { justify-content: flex-end; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
    /* 카드가 홀수면 마지막 카드는 두 칸을 쓰고 그림을 왼쪽에 둔다(혼자 반 칸에 남지 않게) */
    .cards li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .cards li:last-child:nth-child(odd) .card-a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 32px; align-content: start; }
    .cards li:last-child:nth-child(odd) .thumb { grid-row: 1 / span 5; }
    .cards li:last-child:nth-child(odd) .chip { justify-self: start; }
    .follow { grid-template-columns: 1fr auto; align-items: center; gap: 48px; padding: 44px 48px; }
    .follow ul { min-width: 300px; }
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".flt");
  const items = document.querySelectorAll<HTMLLIElement>(".cards li");
  const status = document.getElementById("flt-status")!;
  btns.forEach((b) => b.addEventListener("click", () => {
    const k = b.dataset.kind!;
    btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let n = 0;
    items.forEach((li) => { const show = k === "전체" || li.dataset.kind === k; li.hidden = !show; if (show) n++; });
    status.textContent = `${k} ${n}개`;
  }));
</script>
