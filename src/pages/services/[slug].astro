---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import svcData from "../../data/services.json";
import calcData from "../../data/calculators.json";
import home from "../../data/home.json";
import site from "../../data/site.json";

export function getStaticPaths() {
  return svcData.services.map((s) => ({ params: { slug: s.slug }, props: { svc: s } }));
}
const { svc } = Astro.props as { svc: any };
const calcs = svc.calculators.map((slug: string) => calcData.calculators.find((c) => c.slug === slug)!);
const book = svc.book ? home.books.find((b) => b.title === svc.book) : null;
---
<Base title={svc.name} description={svc.short} cta={svc.urgent ? "urgent" : "default"}>
  <PageHead dark title={svc.name} lead={svc.short} crumbs={[{ name: "서비스", href: "/services" }, { name: svc.name }]} />

  {svc.urgent && (
    <div class="gut urgent-band"><p class="wrap">{svc.urgent}</p></div>
  )}

  <section class="sec gut" aria-labelledby="h-dl">
    <div class="wrap narrow">
      <span class="tag">기한부터 확인하세요</span>
      <h2 class="sec-h" id="h-dl">신고·청구 기한</h2>
      <div class="dls">
        {svc.deadlines.map((d: any) => (
          <div class="card dl">
            <h3>{d.title}</h3>
            {d.track && (
              <div class="track" aria-hidden="true">
                <span class="ln"></span><span class="fl"></span>
                <span class="dot" style="left:0"></span>
                {d.track[1] && <span class="dot" style="left:22%"></span>}
                <span class="dot end" style="left:100%"></span>
                <span class="lb s">{d.track[0]}</span>
                {d.track[1] && <span class="lb m">{d.track[1]}</span>}
                <span class="lb e">{d.track[2]}</span>
              </div>
            )}
            <p>{d.text}</p>
            <p class="law">{d.law}</p>
          </div>
        ))}
      </div>
      <p class="note">기한이 토·일요일이나 공휴일이면 그다음 날까지입니다. 사정마다 다를 수 있으니 상담 때 함께 확인해 드립니다.</p>
    </div>
  </section>

  <section class="sec sec-alt gut" aria-labelledby="h-who">
    <div class="wrap narrow">
      <span class="tag">이런 분께</span>
      <h2 class="sec-h" id="h-who">이런 상황이라면</h2>
      <ul class="who">{svc.forWho.map((t: string) => <li>{t}</li>)}</ul>
    </div>
  </section>

  <section class="sec gut" aria-labelledby="h-do">
    <div class="wrap narrow two">
      <div>
        <span class="tag">함께 하는 일</span>
        <h2 class="sec-h" id="h-do">맡겨 주시면</h2>
        <ul class="does">{svc.does.map((t: string) => <li>{t}</li>)}</ul>
        <p class="note">세금이 얼마나 줄어드는지 같은 결과는 약속하지 않습니다. 사실관계에 따라 달라집니다.</p>
      </div>
      <div>
        <span class="tag">진행 순서</span>
        <h2 class="sec-h">이렇게 진행합니다</h2>
        <ol class="steps">{svc.steps.map((s: any) => <li><b>{s.title}</b><span>{s.text}</span></li>)}</ol>
      </div>
    </div>
  </section>

  {calcs.length > 0 && (
    <section class="sec sec-alt gut" aria-labelledby="h-cal">
      <div class="wrap">
        <span class="tag">먼저 계산해 보기</span>
        <h2 class="sec-h" id="h-cal">관련 계산기</h2>
        <div class="grid-cards" style="margin-top:16px">
          {calcs.map((c: any) => <a class="calc-card" href={`/calculators/${c.slug}`}><b>{c.name}</b><span>{c.short}</span></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="sec gut" aria-labelledby="h-prep">
    <div class="wrap narrow">
      <span class="tag">상담 전에</span>
      <h2 class="sec-h" id="h-prep">가져오시면 좋은 것</h2>
      <ul class="does">{svc.prepare.map((t: string) => <li>{t}</li>)}</ul>
      <p class="note">상담을 빠르게 하려는 목록이며, 법에서 정한 신고 첨부서류 목록은 아닙니다. 없는 것이 있어도 괜찮습니다.</p>
      {book && (
        <a class="book" href={site.booksUrl} target="_blank" rel="noopener">
          <span class="bk" style={`--c:${book.color}`} aria-hidden="true"></span>
          <span><small>관련 책</small><b>『{book.title}』</b><span>{site.rep} 지음 · 교보문고 ↗</span></span>
        </a>
      )}
    </div>
  </section>

</Base>

<style>
  .urgent-band { background: var(--gold-soft); border-bottom: 1px solid rgba(160, 120, 40, .3); }
  .urgent-band p { padding-block: 14px; font-weight: 600; color: var(--ink); }
  .dls { display: grid; gap: 14px; margin-top: 18px; }
  .dl { display: grid; gap: 8px; }
  .dl h3 { font-size: 18px; }
  .dl p { color: var(--ink2); }
  .track { position: relative; height: 58px; margin: 4px 8px 4px; }
  .ln, .fl { position: absolute; left: 0; right: 0; top: 10px; height: 3px; border-radius: 2px; }
  .ln { background: var(--paper2); }
  .fl { background: var(--gold); transform-origin: left; animation: fill .9s cubic-bezier(.4, 0, .2, 1) .2s both; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .dot { position: absolute; top: 3px; width: 17px; height: 17px; border-radius: 50%; background: var(--surface); border: 3px solid var(--gold); transform: translateX(-50%); }
  .dot.end { background: var(--gold); }
  .lb { position: absolute; top: 28px; font-size: 14px; color: var(--ink2); white-space: nowrap; }
  .lb.s { left: -8px; }
  .lb.m { left: 22%; transform: translateX(-50%); }
  .lb.e { right: -8px; font-weight: 700; color: var(--gold-text); }
  .note { margin-top: 12px; font-size: 15px; color: var(--muted); }
  .who { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .who li { background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: 4px; padding: 14px 16px; font-size: 17px; }
  .two { display: grid; gap: 40px; }
  .does { margin: 14px 0 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--ink2); }
  .does li::marker { color: var(--gold); }
  .steps { list-style: none; margin: 14px 0 0; padding: 0; counter-reset: st; }
  .steps li { display: grid; grid-template-columns: 36px 1fr; column-gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .steps li::before { counter-increment: st; content: counter(st); grid-row: span 2; width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--gold); display: grid; place-items: center; color: var(--gold-text); font-weight: 700; font-size: 15px; }
  .steps b { font-size: 17px; }
  .steps span { font-size: 15.5px; color: var(--muted); }
  .book { margin-top: 24px; display: flex; gap: 16px; align-items: center; text-decoration: none; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; }
  .book:hover { border-color: var(--gold); }
  .bk { flex: none; width: 56px; height: 80px; background: var(--c); border-radius: 1px 3px 3px 1px; box-shadow: inset 3px 0 0 rgba(0, 0, 0, .18); position: relative; }
  .bk::after { content: ""; position: absolute; left: 8px; right: 8px; top: 14px; height: 2px; background: rgba(255, 247, 230, .7); }
  .book small { display: block; font-size: 14px; color: var(--gold-text); font-weight: 600; }
  .book b { display: block; font-size: 17px; }
  .book > span:last-child > span { font-size: 15px; color: var(--muted); }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; gap: 48px; } .narrow.two > * { max-width: none; } }
</style>
