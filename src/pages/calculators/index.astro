---
// 계산기 목록(2026-10-24 2차 개편): 찾기 칸 + 분야 칩(누르면 그 분야만, 찾은 개수는 화면 읽기로도), 칸은 첫 화면 계산기 칸과 같은 모양(분야 · 이름 · 한 줄 설명)
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import DeadlineBand from "../../components/DeadlineBand.astro";
import calcData from "../../data/calculators.json";
const n = calcData.calculators.length;
const groupName = Object.fromEntries(calcData.groups.map((g) => [g.id, g.name]));
---
<Base title="세금 계산기" description={`상속세·증여세·양도소득세·취득세·종합부동산세 등 모의 세금 계산기 ${n}종.`}>
  <PageHead buki="calculated" tag="직접 만든 계산기" title={`세금 계산기 ${n}종`} crumbs={[{ name: "세금 계산기" }]} lead="결과는 참고용입니다. 실제 세액은 사실관계에 따라 달라집니다." />
  <section class="gut calc-list">
    <div class="wrap">
      <div class="tools">
        <div class="find">
          <label for="calc-q">계산기 찾기</label>
          <input id="calc-q" type="search" placeholder="예: 증여, 퇴직, 법인" autocomplete="off" />
        </div>
        <div class="chips" role="group" aria-label="분야">
          <button type="button" class="fchip" aria-pressed="true" data-g="">전체</button>
          {calcData.groups.map((g) => <button type="button" class="fchip" aria-pressed="false" data-g={g.id}>{g.name}</button>)}
        </div>
      </div>
      <p class="find-msg" role="status" id="calc-msg">{n}개 모두 보는 중</p>
      <ul class="cards reveal">
        {calcData.calculators.map((c) => (
          <li data-g={c.group} data-q={`${c.name} ${c.short} ${groupName[c.group]}`}>
            <a href={`/calculators/${c.slug}`}><small>{groupName[c.group]}</small><b>{c.name}</b><span>{c.short}</span><span class="go">계산하기 ›</span></a>
          </li>
        ))}
      </ul>
      <DeadlineBand kicker="신고 기한이 궁금하면" />
    </div>
  </section>
</Base>
<style>
  .calc-list { padding-block: 28px 64px; }
  .tools { display: grid; gap: 16px; }
  .find { display: grid; gap: 6px; max-width: 420px; min-width: 0; }
  .find label { font-weight: 600; font-size: 16px; }
  .find input { width: 100%; min-width: 0; box-sizing: border-box; min-height: 52px; border: 1px solid var(--line2); border-radius: 8px; padding: 0 14px; font: 17px var(--f-body); color: var(--ink); background: var(--surface); transition: border-color .2s; }
  .find input:hover { border-color: var(--moss); }
  .find input:focus-visible { outline: 3px solid var(--moss); outline-offset: 1px; border-color: var(--moss); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .find-msg { margin: 18px 0 0; font-size: 15px; color: var(--muted); }
  .cards { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cards li[hidden] { display: none; }
  .cards a { display: flex; flex-direction: column; gap: 4px; height: 100%; min-height: 132px; padding: 14px 14px 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; transition: border-color .2s, transform .25s, box-shadow .25s; }
  .cards a:hover, .cards a:focus-visible { border-color: var(--moss); transform: translateY(-3px); box-shadow: 0 10px 22px -14px rgba(21, 25, 21, .45); }
  .cards small { font-size: 14px; color: var(--muted); }
  .cards b { font-size: 16.5px; line-height: 1.45; }
  .cards span:not(.go) { font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  @media (min-width: 900px) {
    .tools { grid-template-columns: 420px 1fr; align-items: end; column-gap: 32px; }
    .cards { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .cards a, .fchip { transition: none; } }
</style>
<script>
  const q = document.getElementById("calc-q") as HTMLInputElement;
  const msg = document.getElementById("calc-msg")!;
  const items = [...document.querySelectorAll<HTMLLIElement>("li[data-q]")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".fchip")];
  let group = "";
  function apply() {
    const words = q.value.trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of items) {
      const hit = (!group || li.dataset.g === group) && words.every((w) => li.dataset.q!.includes(w));
      li.hidden = !hit;
      if (hit) shown++;
  }
    const gname = chips.find((c) => c.dataset.g === group)?.textContent;
    msg.textContent = !shown ? "맞는 계산기가 없어요. 다른 낱말로 찾아 보세요." : !group && !words.length ? `${items.length}개 모두 보는 중` : `${group ? gname + " · " : ""}${shown}개를 찾았어요.`;
  }
  q.addEventListener("input", apply);
  for (const c of chips) c.addEventListener("click", () => {
    group = c.dataset.g || "";
    for (const o of chips) o.setAttribute("aria-pressed", String(o === c));
    apply();
  });
</script>
