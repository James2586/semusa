---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import calcData from "../../data/calculators.json";
const n = calcData.calculators.length;
---
<Base title="세금 계산기" description={`상속세·증여세·양도소득세·취득세·종부세 등 모의 세금 계산기 ${n}종.`}>
  <PageHead title={`세금 계산기 ${n}종`} crumbs={[{ name: "세금 계산기" }]} lead="결과는 참고용입니다. 실제 세액은 사실관계에 따라 달라집니다." />
  <section class="gut" style="padding-bottom:64px">
    <div class="wrap" style="display:grid;gap:32px">
      {calcData.groups.map((g) => (
        <div>
          <h2 class="sec-h" style="font-size:22px">{g.name}</h2>
          <div class="grid-cards" style="margin-top:12px">
            {calcData.calculators.filter((c) => c.group === g.id).map((c) => <a class="calc-card" href={`/calculators/${c.slug}`}><b>{c.name}</b><span>{c.short}</span></a>)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
