---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import calcData from "../../data/calculators.json";
import svcData from "../../data/services.json";
import site from "../../data/site.json";
import KakaoIcon from "../../components/KakaoIcon.astro";
import PlusList from "../../components/PlusList.astro";
import RelatedColumns from "../../components/RelatedColumns.astro";
import rates from "../../data/rates.json";

export function getStaticPaths() {
  return calcData.calculators.map((c) => ({ params: { slug: c.slug }, props: { calc: c } }));
}
const { calc } = Astro.props as { calc: any };
const group = calcData.groups.find((g) => g.id === calc.group)!;
const services = svcData.services.filter((s) => s.calculators.includes(calc.slug));
const siblings = calcData.calculators.filter((c) => c.group === calc.group && c.slug !== calc.slug);
// 이 계산기가 쓰는 세율의 원문(세율·공제 한눈에, 5차 A1)
const rateSecs = rates.sections.filter((s) => s.calculators.includes(calc.slug));
const hasGuide = calc.covers?.length || calc.notCovered?.length || calc.prepare?.length;
const desc = calc.intro ? `${calc.short}. ${calc.intro}`.slice(0, 150) : `${calc.short}. ${site.repTitle} ${site.rep}이 만든 모의 계산기.`;
---
<Base title={calc.name} description={desc} hideBar>
  <PageHead tag={`세금 계산기 · ${group.name}`} title={calc.name} lead={calc.short} crumbs={[{ name: "세금 계산기", href: "/calculators" }, { name: calc.name }]}>
    <p class="meta">검토 {site.repTitle} {site.rep}</p>
  </PageHead>

  <section class="gut intro-sec">
    <div class="wrap narrow">
      {calc.intro && <p class="intro">{calc.intro}</p>}
      {hasGuide && (
        <div class="acc">
          {calc.covers?.length > 0 && <details><summary>이 계산기가 다루는 것<span aria-hidden="true">+</span></summary><ul>{calc.covers.map((t: string) => <li>{t}</li>)}</ul></details>}
          {calc.notCovered?.length > 0 && <details><summary>계산하지 않는 것<span aria-hidden="true">+</span></summary><ul>{calc.notCovered.map((t: string) => <li>{t}</li>)}</ul></details>}
          {calc.prepare?.length > 0 && <details><summary>미리 준비할 숫자<span aria-hidden="true">+</span></summary><ul>{calc.prepare.map((t: string) => <li>{t}</li>)}</ul></details>}
        </div>
      )}
    </div>
  </section>

  <section class="gut calc-sec" id="calc">
    <div class="wrap">
      <div class="frame" id="calc-frame-box">
        <div class="frame-hd">
          <span>{calc.name}</span>
          <a href={calc.url} target="_blank" rel="noopener">새 창에서 열기 ↗<span class="sr-only">(새 창)</span></a>
        </div>
        <div class="frame-body">
          <iframe
            class="calc-frame"
            src={calc.url}
            title={`${calc.name} — 계산 화면`}
            allow="clipboard-write"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
          <div class="frame-wait" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg><span>계산 화면을 불러오는 중</span></div>
        </div>
      </div>
      {/* 불러오는 중 모양: 계산 화면이 뜨면 걷는다(자바스크립트가 없으면 처음부터 안 보임). 바로 뒤에서 걸어야 load를 놓치지 않는다 */}
      <script is:inline>(function(){var b=document.getElementById("calc-frame-box"),f=b.querySelector("iframe");b.classList.add("loading");function done(){b.classList.remove("loading")}f.addEventListener("load",done);setTimeout(done,15000)})();</script>
      <p class="note">결과는 참고용입니다. 실제 세액은 사실관계에 따라 달라집니다. 계산 화면은 안에서 위아래로 움직입니다. 크게 보려면 "새 창에서 열기"를 눌러 주세요.</p>
    </div>
  </section>

  <section class="gut after">
    <div class="wrap narrow">
      <div class="acts">
        <a class="btn btn-kakao btn-block" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />이 결과로 상담하기</a>
        <button class="btn btn-moss btn-block" type="button" data-share={calc.name}>가족에게 이 계산기 보내기</button>
        <p class="note" role="status" data-share-ok>보내는 것은 이 페이지 주소뿐입니다. 입력한 금액은 보내지 않습니다.</p>
      </div>

      {calc.deadline && (
        <div class="prose dl">
          <h2 class="sec-h">신고·납부 기한</h2>
          <p>{calc.deadline.text}</p>
          <p class="law">{calc.deadline.law}</p>
        </div>
      )}

      <h2 class="sec-h more-h">이어서 보기</h2>
      <PlusList label="이어서 보기" items={[
        ...services.map((s) => ({ href: `/services/${s.slug}`, kicker: "서비스", title: `${s.name} 상담 안내`, desc: s.short })),
        ...siblings.map((c) => ({ href: `/calculators/${c.slug}`, kicker: group.name, title: c.name, desc: c.short })),
        ...rateSecs.map((s) => ({ href: `/rates#r-${s.id}`, kicker: "법조문 원문", title: `${s.name} 세율·공제 원문`, desc: "세율표를 법조문 그대로" })),
        { href: "/calculators", title: `세금 계산기 전체 ${calcData.calculators.length}종` },
      ]} />
    </div>
  </section>
  <RelatedColumns calculator={calc.slug} heading="이 계산과 관련된 칼럼" limit={3} />
</Base>

<style>
  .meta { margin-top: 10px; font-size: 14.5px; color: var(--muted); }
  .intro-sec { padding-top: 26px; }
  .intro { color: var(--ink2); margin-bottom: 18px; }
  .acc { border-top: 1px solid var(--line); }
  .acc details { border-bottom: 1px solid var(--line); }
  .acc summary { display: flex; justify-content: space-between; align-items: center; min-height: 56px; cursor: pointer; list-style: none; font-size: 17px; font-weight: 600; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary span { color: var(--gold-text); font-size: 22px; transition: transform .2s; }
  .acc details[open] summary span { transform: rotate(45deg); }
  .acc ul { margin: 0 0 16px; padding-left: 1.1em; display: grid; gap: 6px; color: var(--ink2); font-size: 16.5px; }
  .acc li::marker { color: var(--gold); }
  .calc-sec { padding-block: 28px 8px; }
  /* 계산 화면 틀: 결과 판과 같은 숲색, 오른쪽 "새 창에서 열기" */
  .frame { border: 6px solid var(--moss); border-top: 0; border-radius: 10px; overflow: hidden; background: var(--moss); }
  .frame-hd { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 0 10px; background: var(--moss); color: var(--on-moss); font-size: 15.5px; font-weight: 600; }
  .frame-hd > span { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .frame-hd a { color: var(--gold-hi); font-weight: 500; white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; }
  .frame-body { position: relative; background: var(--surface); border-radius: 4px; overflow: hidden; }
  .frame-wait { position: absolute; inset: 0; display: none; place-content: center; justify-items: center; gap: 14px; background: var(--surface); color: var(--muted); font-size: 15px; }
  .frame-wait svg { width: 34px; height: 34px; color: var(--moss); animation: fspin 2.4s linear infinite; }
  .loading .frame-wait { display: grid; }
  @keyframes fspin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .frame-wait svg { animation: none; } }
  /* 계산기 결과·보고서 창이 화면에 고정되어 뜨므로, 계산 화면은 휴대폰 화면 한 장 높이로 두고 안에서 스크롤한다(높이를 내용에 맞추면 그 창이 화면 밖에 뜰 수 있음) */
  .calc-sec { scroll-margin-top: var(--header-h); }
  .calc-frame { display: block; width: 100%; height: max(560px, calc(100svh - var(--header-h) - 76px)); border: 0; background: var(--surface); }
  .note { margin-top: 10px; font-size: 14.5px; color: var(--muted); }
  .after { padding-block: 24px 64px; }
  .acts { display: grid; gap: 10px; }
  .dl { margin-top: 40px; }
  .more-h { margin-top: 40px; font-size: 23px; }
</style>

<script>
  // 가족에게 보내기: 휴대폰 공유 창(카카오톡 등)으로 페이지 주소만 보낸다. 공유 창이 없으면 주소 복사.
  document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((btn) => {
    const ok = document.querySelector("[data-share-ok]")!;
    btn.addEventListener("click", async () => {
      const data = { title: btn.dataset.share, text: `${btn.dataset.share} — 하나 더`, url: location.href };
      try {
        if (navigator.share) { await navigator.share(data); return; }
        await navigator.clipboard.writeText(location.href);
        ok.textContent = "주소를 복사했어요. 카카오톡 대화창에 붙여 넣어 보내세요.";
      } catch (err) {
        if ((err as Error)?.name !== "AbortError") ok.textContent = `주소: ${location.href}`;
      }
    });
  });
</script>
