---
// 주제 모아 보기(2026-10-24 4차 A1): src/data/topics.json이 잇는 이미 있는 자료를 한 쪽에 — 기한(계산 카드·매년 기한·규칙과 근거)·용어·계산기·질문·서비스·칼럼·책.
// 세법 글을 새로 쓰지 않는다(기한 글은 deadlines.json, 용어 풀이는 glossary.json 그대로).
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import PlusList from "../../components/PlusList.astro";
import BookCover from "../../components/BookCover.astro";
import FaqList from "../../components/FaqList.astro";
import RelatedColumns from "../../components/RelatedColumns.astro";
import UpcomingDeadlines from "../../components/UpcomingDeadlines.astro";
import DeadlineCalc from "../../components/DeadlineCalc.astro";
import topicData from "../../data/topics.json";
import rates from "../../data/rates.json";
import dl from "../../data/deadlines.json";
import glossary from "../../data/glossary.json";
import svcData from "../../data/services.json";
import calcData from "../../data/calculators.json";
import home from "../../data/home.json";
import site from "../../data/site.json";

export function getStaticPaths() {
  return topicData.topics.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: any };
const groupName = Object.fromEntries(calcData.groups.map((g) => [g.id, g.name]));
const evs = t.events.map((id: string) => dl.events.find((e) => e.id === id)!);
const yearly = t.yearly.map((id: string) => dl.yearly.find((e) => e.id === id)!);
const terms = t.glossary.map((id: string) => glossary.terms.find((g) => g.id === id)!);
const calcs = t.calculators.map((s: string) => calcData.calculators.find((c) => c.slug === s)!);
const svcs = t.services.map((s: string) => svcData.services.find((x) => x.slug === s)!);
const books = t.books.map((b: string) => home.books.find((x) => x.title === b)!);
const faqMods = Object.values(import.meta.glob("../../content/faq/*.md", { eager: true })) as any[];
const faqCount = faqMods.filter((m) => t.faq.includes(m.frontmatter.category)).length;
const why = (e: any) => String(e.why || "").replace("{n}", e.rule.monthEnd ?? "");
const others = topicData.topics.filter((x) => x.slug !== t.slug);
const rateSecs = rates.sections.filter((s) => s.topic === t.slug);
---
<Base title={`${t.name} 모아 보기`} description={t.lead}>
  <PageHead tag="주제 모아 보기" title={t.name} lead={t.lead} crumbs={[{ name: "주제 모아 보기", href: "/topics" }, { name: t.name }]} />

  <nav class="gut tp-nav" aria-label="다른 주제">
    <div class="wrap tp-chips">{others.map((o) => <a class="fchip" href={`/topics/${o.slug}`}>{o.name}</a>)}</div>
  </nav>

  <section class="sec gut" aria-labelledby="h-tdl">
    <div class="wrap">
      <span class="tag">기한부터</span>
      <h2 class="sec-h" id="h-tdl">신고·청구 기한</h2>
      <div class="tp-two">
        <div class="tp-main">
          {evs.length > 0 && <DeadlineCalc events={t.events} uid={`t-${t.slug}`} heading={`${t.name} 기한 계산`} />}
          {evs.length === 0 && yearly.length > 0 && (<><h3 class="sub-h">매년 돌아오는 날</h3><p class="sec-sub">오늘부터 남은 날 순서입니다.</p><UpcomingDeadlines only={t.yearly} /></>)}
        </div>
        <div>
          <h3 class="sub-h">기한 규칙과 근거</h3>
          <ol class="tp-rules reveal">
            {evs.map((e: any) => <li><b>{e.name}</b><p>{why(e)}{e.rule.abroadMonths ? ` (${e.abroadLabel}이면 ${e.rule.abroadMonths}개월)` : ""}</p><p class="law">{e.law}</p></li>)}
            {yearly.map((y: any) => <li><b>{y.name}</b><p>{y.when}</p><p class="law">{y.law}</p></li>)}
          </ol>
          <p class="note">기한이 토·일요일이나 공휴일이면 그다음 날까지입니다. {evs.length > 0 ? <a href={`/deadline?e=${t.events[0]}`}>기한 달력으로 보기 ›</a> : <a href="/tax-calendar">올해 세금 달력 ›</a>}</p>
        </div>
      </div>
    </div>
  </section>

  {terms.length > 0 && (
    <section class="sec gut ruled" aria-labelledby="h-tterm">
      <div class="wrap">
        <span class="tag">용어 풀이</span>
        <h2 class="sec-h" id="h-tterm">먼저 알아 둘 말</h2>
        <dl class="tp-terms reveal">
          {terms.map((g: any) => (
            <div><dt><a href={`/glossary#g-${g.id}`}>{g.term}</a></dt><dd>{g.plain}<span class="law">{g.law}</span></dd></div>
          ))}
        </dl>
        <p class="more"><a class="more-link" href="/glossary">용어 풀이 전체 · 법조문 원문 ›</a></p>
      </div>
    </section>
  )}

  {calcs.length > 0 && (
    <section class="sec gut ruled" aria-labelledby="h-tcal">
      <div class="wrap">
        <span class="tag">먼저 계산해 보기</span>
        <h2 class="sec-h" id="h-tcal">관련 계산기</h2>
        <p class="sec-sub">결과는 참고용입니다. 실제 세액은 사실관계에 따라 달라집니다.{rateSecs.map((s) => <> <a class="tp-rate" href={`/rates#r-${s.id}`}>{s.name} 세율 원문 ›</a></>)}</p>
        <PlusList label="관련 계산기" items={calcs.map((c: any) => ({ href: `/calculators/${c.slug}`, kicker: groupName[c.group], title: c.name, desc: c.short }))} />
      </div>
    </section>
  )}

  {faqCount > 0 && (
    <section class="sec gut ruled" aria-labelledby="h-tfaq">
      <div class="wrap narrow">
        <span class="tag">이 주제에 대한 질문</span>
        <h2 class="sec-h" id="h-tfaq">많이 물어보시는 것</h2>
        <div style="margin-top:18px"><FaqList categories={t.faq} /></div>
      </div>
    </section>
  )}

  <section class="sec gut ruled" aria-labelledby="h-tsvc">
    <div class="wrap">
      <span class="tag">맡기실 때</span>
      <h2 class="sec-h" id="h-tsvc">관련 서비스</h2>
      <PlusList label="관련 서비스" items={svcs.map((s: any) => ({ href: `/services/${s.slug}`, title: s.name, meta: s.keyDeadlines, desc: s.short }))} />
    </div>
  </section>

  <RelatedColumns topics={t.press} heading={`${t.name}에 대한 칼럼`} />

  {books.length > 0 && (
    <section class="sec gut ruled" aria-labelledby="h-tbook">
      <div class="wrap">
        <span class="tag">더 깊이</span>
        <h2 class="sec-h" id="h-tbook">관련 책</h2>
        <ul class="tp-books">
          {books.map((b: any) => <li><BookCover book={b} width={112} link /><span class="tp-bt">『{b.title}』<small>{site.rep} 지음</small></span></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .tp-nav { border-bottom: 1px solid var(--line); background: var(--surface); }
  .tp-chips { display: flex; flex-wrap: wrap; gap: 8px; padding-block: 12px; }
  .tp-chips .fchip { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .tp-two { display: grid; gap: 36px; margin-top: 20px; }
  .tp-two > * { min-width: 0; }
  .sub-h { font-size: 18px; margin-bottom: 4px; }
  .tp-rules { list-style: none; margin: 14px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .tp-rules li { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .tp-rules b { font-size: 17.5px; }
  .tp-rules p { color: var(--ink2); font-size: 16px; }
  .law { color: var(--muted); font-size: 14.5px; }
  .note { margin-top: 12px; font-size: 15px; color: var(--muted); }
  .note a, .tp-rate { color: var(--ink); font-weight: 600; }
  .tp-terms { margin: 20px 0 0; display: grid; gap: 0; border-top: 1px solid var(--ink); }
  .tp-terms > div { display: grid; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .tp-terms dt a { font-size: 18px; font-weight: 700; color: var(--ink); text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 32px; }
  .tp-terms dd { margin: 0; color: var(--ink2); font-size: 16.5px; line-height: 1.75; display: grid; gap: 4px; }
  .more { margin-top: 22px; }
  .tp-books { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 24px 32px; }
  .tp-books li { display: flex; gap: 16px; align-items: flex-end; }
  .tp-bt { display: grid; gap: 4px; font-weight: 700; font-size: 16.5px; max-width: 14em; }
  .tp-bt small { font-weight: 400; font-size: 14.5px; color: var(--muted); }
  @media (min-width: 900px) {
    .tp-two { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: start; }
    .tp-terms { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  }
</style>
