---
import "../styles/global.css";
import site from "../data/site.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomBar from "../components/BottomBar.astro";
import ClosingCta from "../components/ClosingCta.astro";
import BackToTop from "../components/BackToTop.astro";
import MonthBand from "../components/MonthBand.astro";
import svcData from "../data/services.json";
import calcData from "../data/calculators.json";
import home from "../data/home.json";
import topicData from "../data/topics.json";
import { ogPagesFrom } from "../lib/ogPages.js";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  hideBar?: boolean;
  cta?: "default" | "urgent" | false;
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = `상속·증여·부동산·법인 세금. 책을 쓴 ${site.repTitle} ${site.rep}이 직접 봅니다. 모의 세금 계산기 13종.`,
  noindex = false,
  hideBar = false,
  cta = "default",
  jsonLd = [],
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | 상속·증여·부동산 세금 ${site.repTitle} ${site.rep}`;
const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
// 쪽마다 공유 그림(3차 B3): 목록에 있는 쪽은 public/og/<file>.png, 없으면 사이트 그림
const ogPage = ogPagesFrom({ services: svcData.services, calculators: calcData.calculators, groups: calcData.groups, booksTotal: home.booksTotal, topics: topicData.topics })
  .find((p) => p.path === Astro.url.pathname.replace(/\/$/, "").replace(/\.html$/, ""));
const ogImage = new URL(ogPage ? `/og/${ogPage.file}.png` : "/og.png", site.siteUrl).href;
const org = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  "@id": `${site.siteUrl}/#org`,
  name: site.name,
  url: site.siteUrl,
  email: site.email,
  image: new URL("/og.png", site.siteUrl).href,
  address: { "@type": "PostalAddress", streetAddress: site.address.street, addressLocality: site.address.locality, addressRegion: site.address.region, addressCountry: "KR" },
  openingHours: site.hoursSchema,
  areaServed: "KR",
  sameAs: site.channels.map((c) => c.url),
  founder: { "@type": "Person", name: site.rep, jobTitle: site.repTitle },
  ...(site.phone ? { telephone: site.phone } : {}),
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFFFF" />
    {/* 페이지 넘김 전환 켜기: 바깥 CSS 파일에 두면 첫 화면(기한 계산 스크립트가 있는 쪽)으로 넘어갈 때 Chromium이 켜짐을 놓쳐 전환을 끊는다(2026-10-24 실측) — 머리의 작은 style로 */}
    <style is:inline>@view-transition{navigation:auto}</style>
    {/* 글자 크게(3차 D2): 그리기 전에 붙여 깜빡임 없이 — 저장소를 막은 브라우저는 그냥 지나감 */}
    <script is:inline>try{if(localStorage.getItem("fs")==="lg")document.documentElement.dataset.fs="lg"}catch(e){}</script>
    {/* 오프라인(3차 D1): 기한 달력·세금 달력을 인터넷 없이도 — public/sw.js */}
    <script is:inline>if("serviceWorker"in navigator&&(location.protocol==="https:"||location.hostname==="localhost"))addEventListener("load",function(){navigator.serviceWorker.register("/sw.js").catch(function(){})})</script>
    <link rel="preload" href="/fonts/serif-ko-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/serif-logo-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 칼럼`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <slot name="head" />
  </head>
  <body class:list={[hideBar && "no-bar"]}>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <Header />
    <MonthBand />
    <main id="main" tabindex="-1">
      <slot />
      {cta && <ClosingCta urgent={cta === "urgent"} />}
    </main>
    <Footer />
    {!hideBar && <BottomBar />}
    <BackToTop />
  </body>
</html>
<style is:global>
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 60; background: var(--surface); }
  main:focus { outline: none; }
  body.no-bar .foot { padding-bottom: 36px; }
</style>
