---
import site from "../data/site.json";
import KakaoIcon from "./KakaoIcon.astro";
interface Props { headingLevel?: "h2" | "none" }
const { headingLevel = "none" } = Astro.props;
// 지도 찾기는 건물 주소까지만(층·호수를 붙이면 지도 검색이 못 찾는다) — site.json address.map
const q = encodeURIComponent((site.address as any).map || site.address.full.replace(/^서울시/, "서울"));
// 카카오 지도(2026-10-25 운영자 — 키는 「비상장주식평가」 앱의 JavaScript 키, 등록 도메인에서만 작동): 화면에 가까워질 때만 SDK를 받고,
// 못 받거나 주소를 못 찾으면 지도 칸을 숨긴 채 지도 앱 버튼만 남는다. 끌기·휠 확대는 막는다(쪽 스크롤을 붙잡지 않게 — 확대 단추로만).
const mapKey = (site as any).kakaoMapKey || "";
const mapAddr = (site.address as any).map || site.address.full;
const tel = site.phone ? `tel:${site.phone.replace(/[^0-9+]/g, "")}` : null;
---
<div class="loc">
  <div>
    {headingLevel === "h2" && <><span class="tag">오시는 길</span><h2 class="sec-h">찾아오시는 길</h2></>}
    <dl>
      <dt>주소</dt><dd data-addr>{site.address.full}</dd>
      {site.transit && <><dt>교통</dt><dd>{site.transit}</dd></>}
      {site.parking && <><dt>주차</dt><dd>{site.parking}</dd></>}
      {tel && <><dt>전화</dt><dd><a href={tel}>{site.phone}</a></dd></>}
      {(site as any).fax && <><dt>팩스</dt><dd>{(site as any).fax}</dd></>}
      <dt>운영</dt><dd>{site.hours}</dd>
      <dt>메일</dt><dd>{site.email}</dd>
    </dl>
  </div>
  <div class="acts">
    <button class="btn btn-moss btn-block" type="button" data-copy-addr>주소 복사</button>
    <p class="copy-ok" role="status" data-copy-ok></p>
    <div class="two">
      <a class="btn btn-moss" href={`https://map.kakao.com/link/search/${q}`} target="_blank" rel="noopener">카카오맵 ↗</a>
      <a class="btn btn-moss" href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener">네이버 지도 ↗</a>
    </div>
    <a class="btn btn-kakao btn-block" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />방문 전 카카오톡으로 예약</a>
  </div>
  {mapKey && <div class="kmap" data-kmap data-key={mapKey} data-addr-q={mapAddr} data-label={site.office || site.name} role="img" aria-label={`지도: ${site.address.full}`} hidden></div>}
</div>
<style>
  .loc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  dl { margin: 16px 0 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 20px; font-size: 17px; }
  dd { overflow-wrap: anywhere; }
  dt { color: var(--muted); font-size: 15.5px; padding-top: 1px; }
  dd { margin: 0; }
  .acts { display: grid; gap: 10px; align-content: start; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 10px; }
  .two .btn { white-space: nowrap; padding-inline: 10px; }
  .kmap { grid-column: 1 / -1; height: 260px; border-radius: 10px; border: 1px solid var(--line); overflow: hidden; background: var(--surface); }
  .kmap[hidden] { display: none; }
  @media (min-width: 900px) { .kmap { height: 320px; } }
  .kmap :global(.kmap-tag) { background: var(--moss); color: var(--on-moss); font: 700 14px var(--f-body); padding: 6px 10px; border-radius: 6px; white-space: nowrap; transform: translateY(-46px); box-shadow: 0 6px 14px -8px rgba(0,0,0,.5); }
  .copy-ok { font-size: 15px; color: var(--moss2); min-height: 1.5em; }
  @media (min-width: 900px) { .loc { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; } .acts { padding-top: 8px; } }
</style>
<script>
  // 카카오 지도: SDK는 한 번만, 지도 칸이 화면에 가까워질 때
  let sdk: Promise<any> | null = null;
  function loadKakao(key: string): Promise<any> {
    const w = window as any;
    if (w.kakao?.maps?.services) return Promise.resolve(w.kakao);
    return sdk ||= new Promise((ok, no) => {
      const s = document.createElement("script");
      s.src = `https://dapi.kakao.com/v2/maps/sdk.js?appkey=${encodeURIComponent(key)}&autoload=false&libraries=services`;
      s.async = true;
      const t = setTimeout(() => no(new Error("timeout")), 10000);
      s.onerror = () => { clearTimeout(t); no(new Error("load")); };
      s.onload = () => { clearTimeout(t); w.kakao?.maps?.load ? w.kakao.maps.load(() => ok(w.kakao)) : no(new Error("no kakao")); };
      document.head.appendChild(s);
    });
  }
  document.querySelectorAll<HTMLElement>("[data-kmap]").forEach((box) => {
    const io = new IntersectionObserver((ents) => {
      if (!ents.some((e) => e.isIntersecting)) return;
      io.disconnect();
      loadKakao(box.dataset.key!).then((kakao) => {
        new kakao.maps.services.Geocoder().addressSearch(box.dataset.addrQ, (res: any[], status: string) => {
          if (status !== kakao.maps.services.Status.OK || !res[0]) return;
          box.hidden = false;
          const at = new kakao.maps.LatLng(Number(res[0].y), Number(res[0].x));
          const map = new kakao.maps.Map(box, { center: at, level: 3, draggable: false, scrollwheel: false, disableDoubleClickZoom: true });
          map.addControl(new kakao.maps.ZoomControl(), kakao.maps.ControlPosition.RIGHT);
          new kakao.maps.Marker({ map, position: at });
          const tag = document.createElement("div");
          tag.className = "kmap-tag";
          tag.textContent = box.dataset.label || "";
          new kakao.maps.CustomOverlay({ map, position: at, content: tag, yAnchor: 1 });
        });
      }).catch(() => {});
    }, { rootMargin: "300px" });
    io.observe(box.parentElement || box);
  });
  document.querySelectorAll<HTMLElement>(".loc").forEach((loc) => {
    const btn = loc.querySelector("[data-copy-addr]")!;
    const ok = loc.querySelector("[data-copy-ok]")!;
    const addr = loc.querySelector("[data-addr]")!;
    btn.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(addr.textContent || ""); ok.textContent = "주소를 복사했어요."; }
      catch { const r = document.createRange(); r.selectNodeContents(addr); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); ok.textContent = "주소를 선택했어요. 길게 눌러 복사하세요."; }
    });
  });
</script>
