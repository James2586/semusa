---
import site from "../data/site.json";
import KakaoIcon from "./KakaoIcon.astro";
interface Props { headingLevel?: "h2" | "none" }
const { headingLevel = "none" } = Astro.props;
const q = encodeURIComponent(site.address.full.replace(/^서울시/, "서울"));
---
<div class="loc">
  <div>
    {headingLevel === "h2" && <><span class="tag">오시는 길</span><h2 class="sec-h">찾아오시는 길</h2></>}
    <dl>
      <dt>주소</dt><dd data-addr>{site.address.full}</dd>
      {site.transit && <><dt>교통</dt><dd>{site.transit}</dd></>}
      {site.parking && <><dt>주차</dt><dd>{site.parking}</dd></>}
      <dt>운영</dt><dd>{site.hours}</dd>
      <dt>메일</dt><dd>{site.email}</dd>
    </dl>
  </div>
  <div class="acts">
    <button class="btn btn-line btn-block" type="button" data-copy-addr>주소 복사</button>
    <p class="copy-ok" role="status" data-copy-ok></p>
    <div class="two">
      <a class="btn btn-line" href={`https://map.kakao.com/link/search/${q}`} target="_blank" rel="noopener">카카오맵 ↗</a>
      <a class="btn btn-line" href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener">네이버 지도 ↗</a>
    </div>
    <a class="btn btn-kakao btn-block" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />방문 전 카카오톡으로 예약</a>
  </div>
</div>
<style>
  .loc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  dl { margin: 16px 0 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 20px; font-size: 17px; }
  dd { overflow-wrap: anywhere; }
  dt { color: var(--muted); font-size: 15.5px; padding-top: 1px; }
  dd { margin: 0; }
  .acts { display: grid; gap: 10px; align-content: start; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 10px; }
  .two .btn { white-space: nowrap; padding-inline: 10px; }
  .copy-ok { font-size: 15px; color: var(--moss2); min-height: 1.5em; }
  @media (min-width: 900px) { .loc { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; } .acts { padding-top: 8px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".loc").forEach((loc) => {
    const btn = loc.querySelector("[data-copy-addr]")!;
    const ok = loc.querySelector("[data-copy-ok]")!;
    const addr = loc.querySelector("[data-addr]")!;
    btn.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(addr.textContent || ""); ok.textContent = "주소를 복사했어요."; }
      catch { const r = document.createRange(); r.selectNodeContents(addr); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); ok.textContent = "주소를 선택했어요. 길게 눌러 복사하세요."; }
    });
  });
</script>
