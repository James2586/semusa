---
import site from "../data/site.json";
import KakaoIcon from "./KakaoIcon.astro";
interface Props { urgent?: boolean }
const { urgent = false } = Astro.props;
---
<section class="closing sec-dark gut" aria-labelledby="h-closing">
  <div class="wrap closing-in">
    <h2 id="h-closing" class="closing-h">{urgent ? "기한이 있는 일입니다." : "상황을 먼저 알려 주세요."}</h2>
    <p>카카오톡으로 상황을 적어 보내 주시면 확인 후 연락드립니다. 상담은 유료입니다.</p>
    <a class="btn btn-kakao" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />카카오톡 상담</a>
  </div>
</section>
<style>
  .closing { padding-block: 56px 60px; border-top: 1px solid rgba(243, 240, 231, .08); }
  .closing-in { display: grid; gap: 14px; justify-items: start; }
  .closing-h { font-family: var(--f-display); font-size: 30px; line-height: 1.3; }
  .closing p { color: var(--on-moss2); }
  .closing .btn { margin-top: 6px; width: 100%; }
  @media (min-width: 900px) {
    .closing { padding-block: 96px 100px; }
    .closing-in { justify-items: center; text-align: center; }
    .closing-h { font-size: 56px; }
    .closing .btn { width: auto; min-width: 260px; }
  }
</style>
