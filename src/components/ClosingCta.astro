---
import site from "../data/site.json";
import KakaoIcon from "./KakaoIcon.astro";
const mapQ = encodeURIComponent(site.address.full.replace(/^서울시/, "서울"));
const tel = site.phone ? `tel:${site.phone.replace(/[^0-9+]/g, "")}` : null;
interface Props { urgent?: boolean }
const { urgent = false } = Astro.props;
---
<section class="closing sec-dark gut" aria-labelledby="h-closing">
  <div class="wrap closing-in">
    <h2 id="h-closing" class="closing-h">{urgent ? <>기한이<img class="ipic ipic-photo" src="/img/profile-360.webp" alt="" width="62" height="40" loading="lazy" />있는 일입니다.</> : <>상황을<img class="ipic ipic-photo" src="/img/profile-360.webp" alt="" width="62" height="40" loading="lazy" />먼저 알려 주세요.</>}</h2>
    <p>카카오톡으로 상황을 적어 보내 주시면 확인 후 연락드립니다. 상담은 유료입니다.</p>
    <div class="closing-info">
      <a href={`https://map.kakao.com/link/search/${mapQ}`} target="_blank" rel="noopener">{site.address.full} <span aria-hidden="true">↗</span><span class="sr-only">(카카오맵)</span></a>
      {tel && <a href={tel}>{site.phone}</a>}
    </div>
    <a class="btn btn-kakao" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />카카오톡 상담</a>
  </div>
</section>
<style>
  .closing { padding-block: 56px 60px; border-top: 1px solid rgba(243, 240, 231, .08); }
  .closing-in { display: grid; gap: 14px; justify-items: start; }
  .closing-h { font-family: var(--f-display); font-size: 30px; line-height: 1.3; }
  .closing p { color: var(--on-moss2); }
  .closing .btn { margin-top: 6px; width: 100%; }
  .closing-info { display: grid; gap: 4px; margin-top: 6px; }
  .closing-info a { color: var(--on-moss); font-size: 19px; font-weight: 700; text-decoration: none; }
  .closing-info a:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (min-width: 900px) {
    .closing { padding-block: 96px 100px; }
    .closing-in { justify-items: center; text-align: center; }
    .closing-h { font-size: 56px; }
    .closing .btn { width: auto; min-width: 260px; }
    .closing-info a { font-size: 24px; }
  }
</style>
