---
// 글자 로고 「하나 더+」(2026-10-24 운영자 선택 A — 2026-10-25 운영자 「세무회계라는 단어는 일단 모두 삭제」로 세로선 뒤 글자를 뺌).
// 같은 날 운영자: 그 자리에 「세무법인 성수 송파 WM센터」(site.json office) — 「하나 더+ │ 세무법인 성수 송파 WM센터」, 좁은 화면은 사무소 이름을 두 줄로.
// "하나 더"는 명조 900(로고 전용 글자만 잘라 씀), +는 가는 금색. 화면 읽기는 "하나 더 세무법인 성수 송파 WM센터"로 읽는다(+는 장식).
import site from "../data/site.json";
interface Props { href?: string; dark?: boolean; size?: "md" | "lg" }
const { href, dark = false, size = "md" } = Astro.props;
const Tag = href ? "a" : "span";
// 「세무법인 성수」 · 「송파 WM센터」 두 덩어리 — 좁은 화면에서 둘째 덩어리만 다음 줄로
const [o1, o2] = (() => { const w = site.office.split(" "); const k = Math.ceil(w.length / 2); return [w.slice(0, k).join(" "), w.slice(k).join(" ")]; })();
---
<Tag class:list={["logo", dark && "logo-dark", `logo-${size}`]} href={href}>
  <span class="lw">하나 더<span class="lp" aria-hidden="true">+</span></span><span class="ls"><span class="ls1">{o1}</span> <span class="ls2">{o2}</span></span>
</Tag>
<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; text-decoration: none; color: var(--ink); white-space: nowrap; }
  .lw { font-family: "Hanadeo Logo", var(--f-display); font-weight: 900; font-size: 23px; letter-spacing: -.035em; line-height: 1; }
  .lp { font-family: "Hanadeo Num", "Noto Serif KR", serif; font-weight: 400; color: var(--gold); margin-left: .03em; }
  .ls { font-size: 14px; font-weight: 500; letter-spacing: .01em; color: var(--muted); padding-left: 9px; border-left: 1px solid var(--line2); line-height: 1.25; white-space: normal; }
  .ls1, .ls2 { white-space: nowrap; }
  /* 좁은 화면(머리글): 사무소 이름을 두 줄로 — 찾기·글자 크게·메뉴 단추와 한 줄에 들어가게 */
  @media (max-width: 899px) { .logo-md .ls { display: inline-grid; } .logo-md .ls2 { margin-top: 1px; } }
  @media (max-width: 399px) { .logo-md { gap: 6px; } .logo-md .ls { padding-left: 7px; } }
  .logo-dark { color: #F3F0E7; }
  .logo-dark .ls { color: #A8A396; border-left-color: rgba(243, 240, 231, .22); }
  .logo-dark .lp { color: var(--gold-hi); }
  .logo-lg .lw { font-size: 28px; }
  .logo-lg .ls { font-size: 15px; }
</style>
