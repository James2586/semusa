---
import site from "../data/site.json";
import KakaoIcon from "./KakaoIcon.astro";
const tel = site.phone ? `tel:${site.phone.replace(/[^0-9+]/g, "")}` : null;
---
<nav class="bbar" aria-label="빠른 상담">
  {tel
    ? <a class="bb-tel" href={tel}>전화하기</a>
    : <a href="/calculators"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M8 15h2M12 15h2M8 18h2M12 18h2"/></svg>계산기</a>}
  <a class="bb-kakao" href={site.kakaoUrl} target="_blank" rel="noopener"><KakaoIcon />카카오톡 상담</a>
</nav>
<style>
  .bbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1.5fr; background: var(--surface); border-top: 1px solid var(--line2); padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px); }
  .bbar a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: var(--bar-h); text-decoration: none; font: 700 17px var(--f-body); color: var(--ink); }
  .bbar :global(svg) { width: 20px; height: 20px; flex: none; }
  .bb-kakao { background: var(--kakao); color: var(--kakao-ink) !important; }
  .bb-tel { background: var(--moss); color: var(--on-moss) !important; }
  @media (min-width: 1024px) { .bbar { display: none; } }
</style>
