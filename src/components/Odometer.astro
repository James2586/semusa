---
// 자릿수 바퀴 숫자(2026-10-24 2차 개편 — 소개 쪽 숫자): 화면에 들어올 때 한 번, 0에서 몇 바퀴 돌아 멈춘다.
// 자바스크립트가 없거나 움직임 줄이기면 처음부터 완성된 숫자. 화면 읽기는 숫자 글자(sr-only)만 읽는다.
interface Props { n: number; cls?: string }
const { n, cls } = Astro.props;
const digits = String(n).split("").map(Number);
const CYCLES = 3;
---
<span class:list={["odo", cls]} data-odo><span class="sr-only">{n}</span><span class="odo-in" aria-hidden="true">{digits.map((d, i) => (
  <span class="odo-r"><span class="odo-c" style={`--to:${d + 10 * (CYCLES - 1)};--i:${i}`}>{Array.from({ length: 10 * CYCLES }, (_, k) => <i>{k % 10}</i>)}</span></span>
))}</span></span>
{/* 그리기 전에 0으로 돌려 둔다(뒤의 모듈 스크립트는 첫 그림 뒤에 돌 수 있어 완성된 숫자가 한 번 비쳤다 돌아감) */}
<script is:inline>(function(s){var e=s.previousElementSibling;if(!matchMedia("(prefers-reduced-motion: reduce)").matches&&"IntersectionObserver"in window)e.classList.add("odo-wait")})(document.currentScript)</script>
<style is:global>
  .odo { display: inline-flex; vertical-align: baseline; }
  .odo-in { --h: 1.25em; display: inline-flex; height: var(--h); overflow: hidden; line-height: var(--h); font-variant-numeric: tabular-nums;
    -webkit-mask-image: linear-gradient(transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(transparent, #000 8%, #000 92%, transparent); }
  .odo-r { display: block; height: var(--h); overflow: hidden; }
  .odo-c { display: flex; flex-direction: column; transform: translateY(calc(var(--h) * var(--to) * -1)); }
  .odo-c i { font-style: normal; height: var(--h); display: block; text-align: center; }
  .odo.odo-wait .odo-c { transform: none; }
  .odo.odo-go .odo-c { transition: transform calc(.8s + var(--i) * .14s) cubic-bezier(.16, .84, .3, 1) .1s; }
  @media (prefers-reduced-motion: reduce) { .odo.odo-wait .odo-c { transform: translateY(calc(var(--h) * var(--to) * -1)); } }
</style>
<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        io.unobserve(el);
        void el.offsetHeight;
        el.classList.add("odo-go");
        requestAnimationFrame(() => el.classList.remove("odo-wait"));
      }
    }, { threshold: 0.6 });
    document.querySelectorAll<HTMLElement>("[data-odo].odo-wait").forEach((el) => io.observe(el));
  }
</script>
